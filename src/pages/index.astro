---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
---

<BaseLayout>
  
  <Hero />
	<Features />

	<!-- 2-Column Grid -->
  <section class="grid">
    <div>
      <h2>Column One</h2>
      <p>Pico builds column rows evenly.</p>
    </div>
    <div>
      <h2>Column Two</h2>
      <p>No grid template fractions required.</p>
    </div>
  </section>
	

	<!-- Full-Width Section -->
	<section>
		<h2>Full Width</h2>
		<p>Sections are full width by default.</p>
